# ==============================================================================
# Food Freshness Monitoring Platform - Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual settings.
# ==============================================================================

# MongoDB Database Connection
# Atlas Connection String Example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/food_freshness_db?retryWrites=true&w=majority
# Local MongoDB Connection Example:
MONGO_URI=mongodb://127.0.0.1:27017/food_freshness_db
DATABASE_NAME=food_freshness_db

# JWT Authentication & Cryptography
JWT_SECRET=replace_with_a_strong_random_jwt_secret_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Social Authentication: Google Sign-In (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server & Network Configuration
HOST=127.0.0.1
PORT=9000
ENVIRONMENT=development
DEBUG=True

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins (e.g., http://localhost:3000,http://127.0.0.1:5500,https://yourdomain.com)
CORS_ORIGINS=*

# Optional Default Admin Bootstrapping
ADMIN_DEFAULT_EMAIL=admin@foodfresh.com
ADMIN_DEFAULT_PASSWORD=AdminPassword123!
