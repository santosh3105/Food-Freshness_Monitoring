# ==============================================================================
# Food Freshness Monitoring Platform - Production Environment Configuration
# ==============================================================================

# MongoDB Atlas Database URI (SSL/TLS Replica Set)
# Replace <username>, <password>, and <cluster-url> with your real MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_freshness_db?retryWrites=true&w=majority
DATABASE_NAME=food_freshness_db

# Cryptographic JWT Secret (Must be >= 32 characters in production)
# Generate a secure 64-character token via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Set to your Vercel frontend domain or * for public APIs)
CORS_ORIGINS=https://food-freshness-platform.vercel.app,https://*.vercel.app

# Optional Google OAuth Sign-In Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
